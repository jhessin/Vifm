" Kanagawa Dragon for Vifm (256-color, Windows-compatible)

highlight clear

" Main window background
highlight Win          ctermfg=252 ctermbg=234

" Cursor line
highlight CurrLine     ctermbg=236

" Top bar
highlight TopLine      ctermfg=223 ctermbg=236

" Status line
highlight StatusLine   ctermfg=223 ctermbg=236

" Borders / splits
highlight Border       ctermfg=238 ctermbg=234

" Selection
highlight Selected     ctermbg=238

" File types
highlight Directory    ctermfg=109
highlight Link         ctermfg=110
highlight BrokenLink   ctermfg=167
highlight Executable   ctermfg=108
highlight Device       ctermfg=173
highlight Fifo         ctermfg=180
highlight Socket       ctermfg=175

" Errors
highlight ErrorMsg     ctermfg=160 ctermbg=234
