" Kanagawa Dragon for Vifm (256-color, Windows-compatible, darker selected pane)

highlight clear

" Main window background
highlight Win          ctermfg=252 ctermbg=234

" Cursor line
highlight CurrLine     ctermbg=236

" Inactive pane path
highlight TopLine      ctermfg=223 ctermbg=235

" Active pane path (darker background)
highlight TopLineSel   ctermfg=223 ctermbg=233

" Status line (slightly lighter than TopLineSel)
highlight StatusLine   ctermfg=223 ctermbg=237

" Borders / splits
highlight Border       ctermfg=238 ctermbg=234

" Selection (file selection inside panes)
highlight Selected     ctermfg=223 ctermbg=238

" File types
highlight Directory    ctermfg=109
highlight Link         ctermfg=110
highlight BrokenLink   ctermfg=167
highlight Executable   ctermfg=108
highlight Device       ctermfg=173
highlight Fifo         ctermfg=180
highlight Socket       ctermfg=175

" Errors
highlight ErrorMsg     ctermfg=160 ctermbg=234
